############Plot individual wards

plot_ward_ghsl <- function(ward_name, data, out_dir) {
  
  # Filter to this ward
  ward_data <- data %>% filter(WardName == ward_name)
  
  if (nrow(ward_data) == 0) {
    message("  ⚠ No grids found for ward: ", ward_name, " — skipping")
    return(invisible(NULL))
  }
  
  # Only show colours/legend entries for classes present in this ward
  present_classes <- ward_data %>%
    st_drop_geometry() %>%
    filter(!is.na(dominant_class)) %>%
    pull(dominant_class) %>%
    droplevels() %>%
    levels()
  
  colours_used <- class_colours[names(class_colours) %in% present_classes]
  
  # Count grids per class for subtitle
  class_counts <- ward_data %>%
    st_drop_geometry() %>%
    count(dominant_class, name = "n") %>%
    arrange(desc(n)) %>%
    mutate(label = paste0(dominant_class, " (", n, ")")) %>%
    pull(label) %>%
    paste(collapse = " · ")
  
  p <- ggplot(ward_data) +
    geom_sf(aes(fill = dominant_class), color = "white", linewidth = 0.3) +
    scale_fill_manual(
      values   = colours_used,
      na.value = "#eeeeee",
      name     = "Dominant class",
      drop     = TRUE
    ) +
    labs(
      title    = ward_name,
      subtitle = class_counts,
      caption  = "JRC GHS-SMOD V2 P2023A (2020) | 500m grids | Dominant = highest % class"
    ) +
    map_theme()
  
  # Safe filename (replace / and spaces)
  safe_name <- gsub("[/ ]", "_", ward_name)
  out_path  <- file.path(out_dir, paste0("GHSL_dominant_", safe_name, ".png"))
  
  ggsave(out_path, p, width = 7, height = 6, dpi = 180, bg = "white")
  message("  ✓ Saved: ", basename(out_path))
  
  invisible(p)
}

