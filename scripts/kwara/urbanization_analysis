  "pct_LowDensityRural",
  "pct_RuralCluster",
  "pct_SuburbanPeriUrban",
  "pct_SemiDenseUrban",
  "pct_DenseUrbanCluster",
  "pct_UrbanCentre",
  "pct_Water",
  "pct_NoData"
)

# Clean labels for the legend (must match pct_cols order exactly)
class_labels <- c(
  "Very low density rural",
  "Low density rural",
  "Rural cluster",
  "Suburban / peri-urban",
  "Semi-dense urban cluster",
  "Dense urban cluster",
  "Urban centre",
  "Water",
  "No data"
)

# Colours
class_colours <- c(
  "Very low density rural"    = "#cdf57a",
  "Low density rural"         = "#abcd66",
  "Rural cluster"             = "#375623",
  "Suburban / peri-urban"     = "#ffff00",
  "Semi-dense urban cluster"  = "#a87000",
  "Dense urban cluster"       = "#732600",
  "Urban centre"              = "#ff0000",
  "Water"                     = "#7ab6f5",
  "No data"                   = "#cccccc"
)

ghsl_dominant <- ghsl_500m %>%
  # Replace NA with 0 so max() works cleanly
  mutate(across(all_of(pct_cols), ~ replace_na(.x, 0))) %>%
  rowwise() %>%
  mutate(
    dominant_pct   = max(c_across(all_of(pct_cols)), na.rm = TRUE),
    dominant_index = which.max(c_across(all_of(pct_cols))),
    dominant_class = class_labels[dominant_index]
  ) %>%
  ungroup() %>%
  mutate(
    dominant_class = factor(dominant_class, levels = class_labels)
  )


present_classes <- ghsl_dominant %>%
  st_drop_geometry() %>%
  filter(!is.na(dominant_class)) %>%
  pull(dominant_class) %>%
  unique() %>%
  as.character()

colours_used <- class_colours[names(class_colours) %in% present_classes]

ggplot(ghsl_dominant) +
  geom_sf(aes(fill = dominant_class), color = "white", linewidth = 0.15) +
  scale_fill_manual(
