## DEGREE OF URBANISATION LEVEL 2
#==========================================================================================

#Load level 3 degree of urbanization plan
L2dou <- rast(file.path(rasterDir, "NGA_DUG_2025_GRID_L2_R2025A_v1.tif"))  

#Extract data at each 500m grid
extracted_L2 <- terra::extract(L2dou, grid_500m, fun = NULL, exact = TRUE) 
names(extracted_L2) <- c("grid_id", "dou_class", "fraction") 

pct_table_L2 <- extracted_L2 %>%
  group_by(grid_id, dou_class) %>%
  summarise(weight = sum(fraction), .groups = "drop") %>%
  group_by(grid_id) %>%
  mutate(pct = weight / sum(weight) * 100) %>%
  ungroup()

#Merge with grid data

level2_dou <- cbind(grid_500m, pct_table_L2)


# ── DoU Level 2 class definitions ─────────────────────────────────────────────
dou_labels <- c(
  "10" = "Water",
  "11" = "Very low density rural",
  "12" = "Low density rural",
  "13" = "Rural cluster",
  "21" = "Suburban / peri-urban",
  "22" = "Semi-dense urban cluster",
  "23" = "Dense urban cluster",
  "30" = "Urban centre"
)

# Colours aligned with GHSL/DoU convention
dou_colours <- c(
  "Water"                    = "#7ab6f5",
  "Very low density rural"   = "#cdf57a",
  "Low density rural"        = "#abcd66",
  "Rural cluster"            = "#375623",
  "Suburban / peri-urban"    = "#ffff00",
  "Semi-dense urban cluster" = "#a87000",
  "Dense urban cluster"      = "#732600",
  "Urban centre"             = "#ff0000"
)

# Full factor level order (ensures legend is always ordered low → high)
dou_levels <- c(
  "Water",
  "Very low density rural",
  "Low density rural",
  "Rural cluster",
  "Suburban / peri-urban",
  "Semi-dense urban cluster",
  "Dense urban cluster",
  "Urban centre"
)

# ── Prepare data ───────────────────────────────────────────────────────────────

dou_dominant <- level2_dou %>%
  st_as_sf() %>%
  # Ensure dou_class is character for the recode lookup
  mutate(dou_class = as.character(dou_class)) %>%
  # For each grid, keep only the row with the highest pct
  group_by(grid_id) %>%
  slice_max(pct, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  # Attach human-readable label and set factor order
  mutate(
    dominant_label = dou_labels[dou_class],
    dominant_label = factor(dominant_label, levels = dou_levels)
  )

# ── Per-ward plot function ────────────────────────────────────────────────────
plot_ward_dou <- function(ward_name, data, out_dir) {
  
  ward_data <- data %>% filter(WardName == ward_name)
  
  if (nrow(ward_data) == 0) {
    message("  ⚠ No grids found for: ", ward_name, " — skipping")
    return(invisible(NULL))
  }
  
  # Classes present in this ward (preserves correct legend order)
  present_labels <- levels(droplevels(ward_data$dominant_label))
  colours_used   <- dou_colours[names(dou_colours) %in% present_labels]
  
  # Subtitle: class breakdown count
  class_summary <- ward_data %>%
    st_drop_geometry() %>%
    count(dominant_label, name = "n") %>%
    arrange(dominant_label) %>%
    mutate(txt = paste0(dominant_label, " (", n, ")")) %>%
    pull(txt) %>%
    paste(collapse = " · ")
  
  p <- ggplot(ward_data) +
    geom_sf(aes(fill = dominant_label), color = "white", linewidth = 0.15) +
    scale_fill_manual(
      values   = colours_used,
      na.value = "#eeeeee",
      name     = "DoU class",
      drop     = TRUE
    ) +
    labs(
      title    = ward_name,
      subtitle = class_summary,
      caption  = "WorldPop Degree of Urbanisation L2 (2025) | 500 m grids | Dominant = highest % class"
    ) +
    map_theme()
  
  safe_name <- gsub("[/ ]", "_", ward_name)
  out_path  <- file.path(out_dir, paste0("DoU_L2_dominant_", safe_name, ".png"))
  
  ggsave(out_path, p, width = 7, height = 6, dpi = 180, bg = "white")
  message("  ✓ ", basename(out_path))
  
  invisible(p)
}

# ── Run for all wards in the dataset ──────────────────────────────────────────
all_wards <- dou_dominant %>%
  st_drop_geometry() %>%
  distinct(WardName) %>%
  arrange(WardName) %>%
  pull(WardName)

message("Generating DoU L2 dominant class maps for ", length(all_wards), " wards...")
walk(all_wards, ~ plot_ward_dou(.x, dou_dominant, outputDir))
